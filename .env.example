# Copy this file to .env and fill in real values.
# Never commit .env (it is git-ignored).

# Better Auth: signing secret (generate a long random string)
BETTER_AUTH_SECRET=<your-random-secret>

# Base URL of this Next.js app
BETTER_AUTH_URL=http://localhost:3000

# MongoDB connection string (same database as the server)
DB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Express backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000
